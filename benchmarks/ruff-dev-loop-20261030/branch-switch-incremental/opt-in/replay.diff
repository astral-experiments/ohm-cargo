+    def copy_sdk_file(src, dst):
+        # Immutable SDK members stay on the same device. Only driver.next is
+        # replaced during measurements, and replacement cannot modify its donor.
+        try:
+            os.link(src, dst)
+            return dst
+        except OSError as error:
+            import errno
+            if error.errno != errno.EXDEV:
+                raise
+            return shutil.copy2(src, dst)
+    shutil.copytree(kits["P"], stable_kit, symlinks=True, copy_function=copy_sdk_file)
