+    fn assert_manifest_decoder_parity(bytes: &[u8], accepted: bool) -> CargoResult<()> {
+        let expected = serde_json::from_slice::<CheckedRelinkManifest>(bytes)
+            .ok()
+            .map(|value| serde_json::to_vec(&value))
+            .transpose()?;
+        assert_eq!(expected.is_some(), accepted);
+        for len in [
+            None,
+            Some(bytes.len() as u64),
+            Some(1),
+            Some(bytes.len() as u64 + 1),
+        ] {
+            let actual = read_relink_manifest_json(std::io::Cursor::new(bytes), len)
+                .map(|value| serde_json::to_vec(&value))
+                .transpose()?;
+            assert_eq!(actual, expected);
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn relink_manifest_json_preserves_field_and_sequence_behavior() -> CargoResult<()> {
+        let original = manifest_json()?;
+        let mut value: serde_json::Value = serde_json::from_slice(&original)?;
+        value["objects"] = serde_json::json!([{"path": "object.o", "blake3": "hash"}]);
+        let bytes = serde_json::to_vec(&value)?;
+        assert_manifest_decoder_parity(&bytes, true)?;
+        assert_manifest_decoder_parity(&[b" \n\t\r".as_slice(), &bytes].concat(), true)?;
+
+        for field in [
+            "input_checksum",
+            "proof_checksum",
+            "version",
+            "rlink",
+            "executable",
+            "objects",
+        ] {
+            let mut missing = value.clone();
+            missing.as_object_mut().unwrap().remove(field);
+            assert_manifest_decoder_parity(&serde_json::to_vec(&missing)?, false)?;
+        }
+        for (field, contents) in value.as_object().unwrap() {
+            let duplicate = format!("{{{}:{},", serde_json::to_string(field)?, contents);
+            assert_manifest_decoder_parity(&[duplicate.as_bytes(), &bytes[1..]].concat(), false)?;
+        }
+
+        let mut optional = value.clone();
+        optional
+            .as_object_mut()
+            .unwrap()
+            .remove("unused_extern_names");
+        assert_manifest_decoder_parity(&serde_json::to_vec(&optional)?, true)?;
+        optional["unused_extern_names"] = serde_json::Value::Null;
+        assert_manifest_decoder_parity(&serde_json::to_vec(&optional)?, true)?;
+        let duplicate_null = b"{\"unused_extern_names\":null,";
+        assert_manifest_decoder_parity(&[duplicate_null.as_slice(), &bytes[1..]].concat(), false)?;
+
+        let mut sequences = value.clone();
+        sequences["rlink"] = serde_json::json!(["recipe.rlink", "hash"]);
+        sequences["executable"] = serde_json::json!(["app", 42, u64::MAX]);
+        sequences["objects"] = serde_json::json!([["object.o", "hash"]]);
+        assert_manifest_decoder_parity(&serde_json::to_vec(&sequences)?, true)?;
+        let root_sequence = serde_json::json!([
+            value["input_checksum"],
+            value["proof_checksum"],
+            value["version"],
+            value["rlink"],
+            value["executable"],
+            value["objects"],
+            value["unused_extern_names"]
+        ]);
+        assert_manifest_decoder_parity(&serde_json::to_vec(&root_sequence)?, false)?;
+        sequences["rlink"] = serde_json::json!(["recipe.rlink", "hash", "extra"]);
+        assert_manifest_decoder_parity(&serde_json::to_vec(&sequences)?, false)?;
+        Ok(())
+    }
+
+    #[test]
+    fn relink_manifest_json_preserves_unknown_value_validation() -> CargoResult<()> {
+        let mut value: serde_json::Value = serde_json::from_slice(&manifest_json()?)?;
+        value["objects"] = serde_json::json!([{"path": "object.o", "blake3": "hash"}]);
+        let original = serde_json::to_string(&value)?;
+        let deep = format!("{}0{}", "[".repeat(130), "]".repeat(130));
+        for (unknown, accepted) in [
+            ("{\"nested\":[null,true,1.5,\"text\"]}", true),
+            ("1e400", false),
+            ("\"\\ud800\"", false),
+            (deep.as_str(), false),
+        ] {
+            for prefix in ["{", "\"rlink\":{", "\"executable\":{", "\"objects\":[{"] {
+                let replacement = format!("{prefix}\"future\":{unknown},");
+                let bytes = original.replacen(prefix, &replacement, 1);
+                assert_manifest_decoder_parity(bytes.as_bytes(), accepted)?;
+            }
+        }
+        let duplicate_unknown = format!("{{\"future\":1,\"future\":null,{}", &original[1..]);
+        assert_manifest_decoder_parity(duplicate_unknown.as_bytes(), true)?;
+        let invalid_utf8 = [
+            b"{\"future\":\"\xff\",".as_slice(),
+            &original.as_bytes()[1..],
+        ]
+        .concat();
+        assert_manifest_decoder_parity(&invalid_utf8, false)?;
+        Ok(())
+    }
