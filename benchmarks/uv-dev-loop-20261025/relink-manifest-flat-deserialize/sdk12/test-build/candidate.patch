+fn read_relink_manifest_slice(bytes: &[u8]) -> Option<CheckedRelinkManifest> {
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct File {
+        path: PathBuf,
+        blake3: String,
+    }
+
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Object {
+        path: PathBuf,
+        len: u64,
+        modified_nanos: u64,
+    }
+
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Fields {
+        input_checksum: u64,
+        proof_checksum: u64,
+        version: u32,
+        rlink: File,
+        executable: Object,
+        objects: Vec<File>,
+        #[serde(default)]
+        unused_extern_names: Option<Vec<String>>,
+    }
+
+    fn file(value: File) -> RelinkCacheFile {
+        RelinkCacheFile {
+            path: value.path,
+            blake3: value.blake3,
+        }
+    }
+
+    // The writer emits a compact object. Read its fields directly rather than
+    // buffering the manifest in serde's intermediate flatten representation.
+    if bytes.first() == Some(&b'{') {
+        if let Ok(fields) = serde_json::from_slice::<Fields>(bytes) {
+            return Some(CheckedRelinkManifest {
+                input_checksum: fields.input_checksum,
+                proof_checksum: fields.proof_checksum,
+                manifest: RelinkCacheManifest {
+                    version: fields.version,
+                    rlink: file(fields.rlink),
+                    executable: RelinkCacheObject {
+                        path: fields.executable.path,
+                        len: fields.executable.len,
+                        modified_nanos: fields.executable.modified_nanos,
+                    },
+                    objects: fields.objects.into_iter().map(file).collect(),
+                    unused_extern_names: fields.unused_extern_names,
+                },
+            });
+        }
+    }
+
+    // Flatten also validates unknown values, including nested out-of-range
+    // numbers. Preserve that behavior and the original map-only root format.
+    serde_json::from_slice(bytes).ok()
+}
