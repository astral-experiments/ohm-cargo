+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn remapping_a_shared_dependency_preserves_its_manifest_data() {
+        let root = std::env::current_dir().unwrap();
+        let original_source = SourceId::for_path(&root.join("original")).unwrap();
+        let replacement = SourceId::for_path(&root.join("replacement")).unwrap();
+        let mut original = Dependency::parse("example", Some("^1.2"), original_source).unwrap();
+        original.set_optional(true);
+
+        let mut remapped = original.clone().map_source(original_source, replacement);
+        assert_eq!(original.source_id(), original_source);
+        assert_eq!(remapped.source_id(), replacement);
+        assert!(Arc::ptr_eq(&original.inner, &remapped.inner));
+        assert_eq!(remapped.clone().map_source(replacement, original_source), original);
+
+        remapped.set_optional(false);
+        assert!(original.is_optional());
+        assert!(!remapped.is_optional());
+    }
+}
