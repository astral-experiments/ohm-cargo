+        let original = fs::read(&second.alternate).unwrap();
+        for offset in [0, MAGIC.len(), MAGIC.len() + 32, original.len() - 1] {
+            let mut bytes = original.clone();
+            bytes[offset] ^= 1;
+            fs::write(&second.alternate, bytes).unwrap();
+            assert!(second.read().is_none());
