+    _paths: &[(P, Option<(u64, Checksum)>)],
+    _cache: &HashMap<PathBuf, Checksum>,
+    _skippable_dirs: Option<&[PathBuf]>,
+    _parallelism: ChecksumParallelism<'_>,
+) -> Option<PrefetchedChecksums> {
+    None
+}
