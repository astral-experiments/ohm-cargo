+        p.root().move_into_the_past();
+        p.change_file("src/lib.rs", &format!("mod {module};"));
+        p.cargo("build").run();
+        for path in &dep_info_paths {
+            let contents = p.read_file(path);
+            assert!(contents.contains(&format!("{module}.rs")), "{contents}");
