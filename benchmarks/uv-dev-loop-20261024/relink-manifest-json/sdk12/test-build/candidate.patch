+const RELINK_MANIFEST_SLICE_LIMIT: u64 = 1024 * 1024;
+
+fn read_relink_manifest_json(
+    mut reader: impl Read + Seek,
+    len: Option<u64>,
+) -> Option<CheckedRelinkManifest> {
+    if let Some(len) = len.filter(|len| *len <= RELINK_MANIFEST_SLICE_LIMIT) {
+        // The length is only a hint: read an extra byte so a growing file cannot
+        // turn a valid JSON prefix into an accepted manifest. Bound the buffer
+        // independently of the file's current size.
+        let mut bytes = Vec::with_capacity(len as usize + 1);
+        reader.by_ref().take(len + 1).read_to_end(&mut bytes).ok()?;
+        if bytes.len() as u64 == len {
+            return serde_json::from_slice(&bytes).ok();
+        }
+        reader.rewind().ok()?;
+    }
+
+    // Keep streaming large files, or files whose length changed, from the same
+    // opened descriptor rather than reopening a potentially different path.
+    serde_json::from_reader(BufReader::new(reader)).ok()
+}
