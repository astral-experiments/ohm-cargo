+/// The prior executable estimates native link work only for otherwise ordinary, warm test jobs.
+fn previous_test_executable_size(
+    runner: &BuildRunner<'_, '_>,
+    unit: &Unit,
+    freshness: &Freshness,
+) -> Option<u64> {
+    let bcx = runner.bcx;
+    if !cfg!(all(target_os = "linux", target_arch = "x86_64"))
+        || unit.mode != CompileMode::Test
+        || !matches!(freshness, Dirty(reason) if reason.is_dependency_only())
+        || unit.kind != super::CompileKind::Host
+        || !bcx.gctx.cli_unstable().ohm_defaults()
+        || !bcx.gctx.cli_unstable().relink_only()
+        || bcx.build_config.jobs < 4
+        || bcx.build_config.ready_tests.is_some()
+        || !bcx.ws.is_member(&unit.pkg)
+        || bcx.rustc().wrapper.is_some()
+        || bcx.rustc().workspace_wrapper.is_some()
+        || bcx.build_config.primary_unit_rustc.is_some()
+        || bcx.gctx.get_env_os("RUSTC").is_some()
+        || bcx.gctx.build_config().ok()?.rustc.is_some()
+        || unit.profile.codegen_backend.is_some()
+        || !unit.profile.rustflags.is_empty()
+        || bcx
+            .extra_args_for(unit)
+            .is_some_and(|args| !args.is_empty())
+        || runner.compilation.target_linker(unit.kind).is_some()
+        || !runner.user_rustflags_for_cache_admission(unit).is_empty()
+        || !fingerprint::unit_can_use_relink_only(runner, unit)
+    {
+        return None;
+    }
+    let outputs = runner.outputs(unit).ok()?;
+    let executable = outputs
+        .iter()
+        .find(|out| out.flavor == super::FileFlavor::Normal)?;
+    let metadata = executable.path.symlink_metadata().ok()?;
+    (metadata.is_file() && metadata.len() != 0).then_some(metadata.len())
+}
