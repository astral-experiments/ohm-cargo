+#[cfg(test)]
+mod scheduling_tests {
+    use super::{HashMap, next_pending_index};
+
+    #[test]
+    fn picks_short_test_only_at_capacity_with_three_large_jobs_and_an_equal_priority() {
+        const MIB: u64 = 1024 * 1024;
+        let sizes = HashMap::from_iter([
+            ('a', 128 * MIB),
+            ('b', 200 * MIB),
+            ('c', 129 * MIB),
+            ('m', 32 * MIB + 1),
+            ('s', 32 * MIB),
+            ('t', 1),
+            ('L', 128 * MIB),
+        ]);
+        let mut active = HashMap::from_iter([(0, 'a'), (1, 'b'), (2, 'c'), (3, 'x')]);
+        let jobs = [
+            ('t', (), 1),
+            ('s', (), 2),
+            ('t', (), 2),
+            ('m', (), 2),
+            ('L', (), 2),
+        ];
+        assert_eq!(next_pending_index(&jobs, &active, &sizes, 5, 5), 2);
+        assert_eq!(next_pending_index(&jobs, &active, &sizes, 6, 5), 4);
+        assert_eq!(next_pending_index(&jobs, &active, &sizes, 6, 6), 4);
+        assert_eq!(next_pending_index(&jobs[..4], &active, &sizes, 5, 5), 3);
+        let unsupported = [('t', (), 1), ('m', (), 2), ('?', (), 2), ('L', (), 2)];
+        assert_eq!(next_pending_index(&unsupported, &active, &sizes, 5, 5), 3);
+        active.insert(2, 'm');
+        assert_eq!(next_pending_index(&jobs, &active, &sizes, 5, 5), 4);
+    }
+}
