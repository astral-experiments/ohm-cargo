+/// Select a small ready test only when the default pick would start a fourth large one.
+fn next_pending_index<K: Eq + std::hash::Hash, J, Id>(
+    pending: &[(K, J, usize)],
+    active: &HashMap<Id, K>,
+    sizes: &HashMap<K, u64>,
+    jobs: usize,
+    capacity: usize,
+) -> usize {
+    let last = pending.len() - 1;
+    let (next, _, priority) = &pending[last];
+    let large = |unit: &K| {
+        sizes
+            .get(unit)
+            .is_some_and(|&size| size >= 128 * 1024 * 1024)
+    };
+    if jobs < 4 || capacity != jobs || active.len() + 1 != capacity || !large(next) {
+        return last;
+    }
+    if active.values().filter(|unit| large(unit)).take(3).count() < 3 {
+        return last;
+    }
+    pending[..last]
+        .iter()
+        .rposition(|(unit, _, p)| {
+            p == priority
+                && sizes
+                    .get(unit)
+                    .is_some_and(|&size| size <= 32 * 1024 * 1024)
+        })
+        .unwrap_or(last)
+}
