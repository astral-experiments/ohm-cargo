+/// A cfg-disabled integration test can reuse its CGUs if every changed Rust input was unused.
+pub(super) fn can_skip_cfg_disabled_dependencies(
+    fp: &Fingerprint,
+    ignored: &HashSet<UnitIndex>,
+) -> bool {
+    fp.is_early_cutoff_candidate()
+        && fp
+            .deps
+            .iter()
+            .all(|dep| match dep.fingerprint.build_state() {
+                BuildState::Fresh => true,
+                BuildState::BuiltChanged
+                | BuildState::BuiltUnchanged
+                | BuildState::SkippedEarlyCutoff => ignored.contains(&dep.fingerprint.index),
+                BuildState::Pending => false,
+            })
+}
