index 0000000000..c75b8956a1
--- /dev/null
+++ b/src/compiler/ohm_cfg_disabled_test.rs
@@ -0,0 +1,269 @@
+//! Relink cached Rust codegen when the entire integration test was configured out.
+use super::*;
+use cargo_platform::CfgExpr;
+
+pub(super) struct Inputs {
+    root: PathBuf,
+    sysroot: PathBuf,
+    externs: HashSet<InternedString>,
+    units: HashSet<UnitIndex>,
+    cfg: Vec<Cfg>,
+}
+
+impl Inputs {
+    pub(super) fn new(runner: &BuildRunner<'_, '_>, unit: &Unit) -> Option<Self> {
+        if unit.mode != CompileMode::Test || !unit.target.is_test() {
+            return None;
+        }
+        let flags = unit_rustflags_without_ohm_defaults(
+            runner.bcx.gctx,
+            runner.rustflags_for_cache_admission(unit),
+        );
+        let no_user_flags = flags.is_empty()
+            || (runner.bcx.gctx.cli_unstable().headstart()
+                && flags == [OHM_EARLY_METADATA_RUSTFLAG]);
+        if !unit.target.harness()
+            || !runner.bcx.ws.is_member(&unit.pkg)
+            || unit.kind != CompileKind::Host
+            || !runner.bcx.gctx.cli_unstable().ohm_defaults()
+            || !runner.bcx.gctx.cli_unstable().relink_only()
+            || runner.bcx.gctx.cli_unstable().cargo_lints
+            || runner.bcx.gctx.cli_unstable().section_timings
+            || runner.bcx.rustc().wrapper.is_some()
+            || runner.bcx.rustc().workspace_wrapper.is_some()
+            || runner.bcx.build_config.primary_unit_rustc.is_some()
+            || runner.bcx.extra_args_for(unit).is_some()
+            || !unit.profile.rustflags.is_empty()
+            || unit.profile.codegen_backend.is_some()
+            || runner.bcx.target_data.info(unit.kind).ohm_linker_flags == 0
+            || !no_user_flags
+            || runner.compilation.target_linker(unit.kind).is_some()
+            || !runner
+                .bcx
+                .rustc()
+                .supports_transparent_unused_externs(runner.bcx.gctx)
+        {
+            return None;
+        }
+        // Most native integration targets already have an ordinary rlib-only self dependency.
+        if !runner.unit_deps(unit).iter().any(|dep| {
+            dep.unit.pkg == unit.pkg
+                && dep.unit.target.is_lib()
+                && dep
+                    .unit
+                    .target
+                    .rustc_crate_types()
+                    .contains(&CrateType::Cdylib)
+                && dep
+                    .unit
+                    .target
+                    .rustc_crate_types()
+                    .contains(&CrateType::Rlib)
+        }) {
+            return None;
+        }
+        let cfg = runner.bcx.target_data.cfg(unit.kind);
+        if !cfg
+            .iter()
+            .any(|c| matches!(c, Cfg::KeyPair(k, v) if k == "target_os" && v == "linux"))
+        {
+            return None;
+        }
+        let root = unit.target.src_path().path()?.to_owned();
+        let mut externs = HashSet::default();
+        let mut units = HashSet::default();
+        for dep in runner.unit_deps(unit) {
+            if dep.unit.artifact.is_true() || dep.nounused {
+                return None;
+            }
+            if dep.unit.target.is_linkable() {
+                if !externs.insert(dep.extern_crate_name) {
+                    return None;
+                }
+                if runner.bcx.ws.is_member(&dep.unit.pkg)
+                    && dep.unit.mode == CompileMode::Build
+                    && dep.unit.target.is_lib()
+                    && dep.unit.kind == unit.kind
+                {
+                    units.insert(runner.bcx.unit_to_index[&dep.unit]);
+                }
+            }
+        }
+        (!units.is_empty()).then(|| Self {
+            root,
+            sysroot: runner.bcx.target_data.info(unit.kind).sysroot.clone(),
+            externs,
+            units,
+            cfg: cfg.to_vec(),
+        })
+    }
+
+    /// Accept a simple, complete first-line inner attribute over a built-in target constant.
+    /// Other source forms are compiled normally. No user tokens precede the disabled crate.
+    fn disabled_source(path: &Path, cfg: &[Cfg]) -> Option<blake3::Hash> {
+        let mut f = paths::open_regular(path).ok()?;
+        if f.metadata().ok()?.len() > 1 << 20 {
+            return None;
+        }
+        let mut bytes = Vec::new();
+        std::io::Read::by_ref(&mut f)
+            .take((1 << 20) + 1)
+            .read_to_end(&mut bytes)
+            .ok()?;
+        if bytes.len() > 1 << 20 {
+            return None;
+        }
+        let line = std::str::from_utf8(bytes.split(|b| *b == b'\n').next()?)
+            .ok()?
+            .trim_end_matches('\r');
+        let expr = line.strip_prefix("#![cfg(")?.strip_suffix(")]")?;
+        if !expr.bytes().all(|c| {
+            c.is_ascii_alphanumeric() || matches!(c, b' ' | b'\t' | b'_' | b'-' | b'=' | b'"')
+        }) {
+            return None;
+        }
+        let pred = expr.parse::<CfgExpr>().ok()?;
+        if !matches!(&pred, CfgExpr::Value(Cfg::KeyPair(key, _)) if matches!(key.as_str(),
+            "target_arch" | "target_os" | "target_env" | "target_vendor" | "target_endian" | "target_pointer_width"))
+            || pred.matches(cfg)
+        {
+            return None;
+        }
+        Some(blake3::hash(&bytes))
+    }
+
+    /// Bind the genuine compiler, source and flags that produced the saved CGUs. Native
+    /// objects, scripts and linker behavior are handled by the actual link on every edit.
+    pub(super) fn signature(
+        &self,
+        scripts: Option<&BuildScripts>,
+        outputs: &BuildScriptOutputs,
+        current: PackageId,
+        rustc: &ProcessBuilder,
+    ) -> Option<(String, blake3::Hash)> {
+        let frontend = Path::new(rustc.get_program());
+        if !frontend.is_absolute()
+            || frontend.canonicalize().ok()?
+                != self.sysroot.join("bin/rustc").canonicalize().ok()?
+        {
+            return None;
+        }
+        let sensitive = |name: &str| {
+            name.starts_with("LD_") && name != "LD_LIBRARY_PATH"
+                || matches!(name, "RUSTC_LOG" | "LLVM_PROFILE_FILE")
+        };
+        if std::env::vars_os().any(|(n, _)| n.to_str().is_some_and(&sensitive))
+            || rustc
+                .get_envs()
+                .iter()
+                .any(|(n, v)| v.is_some() && sensitive(n))
+        {
+            return None;
+        }
+        let loaded = std::env::var_os("LD_LIBRARY_PATH");
+        if let Some(paths) = &loaded
+            && std::env::split_paths(paths).any(|d| {
+                d.canonicalize()
+                    .ok()
+                    .zip(self.sysroot.join("lib").canonicalize().ok())
+                    .is_none_or(|(d, allowed)| d != allowed)
+            })
+        {
+            return None;
+        }
+        let source = Self::disabled_source(&self.root, &self.cfg)?;
+        let mut h = blake3::Hasher::new();
+        h.update(b"ohm-cfg-disabled-cached-cgus-v1");
+        h.update(source.as_bytes());
+        for arg in rustc.get_args() {
+            let bytes = arg.as_encoded_bytes();
+            h.update(&(bytes.len() as u64).to_le_bytes());
+            h.update(bytes);
+        }
+        h.update(&crate::util::hash_u64(&loaded).to_le_bytes());
+        for (pkg, id) in scripts.into_iter().flat_map(|s| &s.to_link) {
+            let output = outputs.get(*id)?;
+            if *pkg == current
+                && (output
+                    .cfgs
+                    .iter()
+                    .any(|x| x.trim_start().starts_with("target_"))
+                    || output.env.iter().any(|(name, _)| {
+                        name == "PATH" || name == "LD_LIBRARY_PATH" || sensitive(name)
+                    }))
+            {
+                return None;
+            }
+            h.update(
+                &crate::util::hash_u64((
+                    pkg,
+                    &output.cfgs,
+                    &output.check_cfgs,
+                    &output.env,
+                    &output.library_paths,
+                    &output.library_links,
+                    &output.linker_args,
+                ))
+                .to_le_bytes(),
+            );
+        }
+        Some((h.finalize().to_hex().to_string(), source))
+    }
+
+    /// Tie the predicate to the bytes the completed compiler actually read. A source
+    /// replacement during rustc, a macro-loaded file, or an environment read must fall back.
+    pub(super) fn authenticates(&self, dep_info: &Path, cwd: &Path, source: blake3::Hash) -> bool {
+        let Some(d) = fingerprint::parse_rustc_dep_info(dep_info).ok() else {
+            return false;
+        };
+        if d.conflicting_checksums
+            || d.observed_span_inputs.is_some()
+            || !d.env.is_empty()
+            || d.files.len() != 1
+        {
+            return false;
+        }
+        d.files.iter().all(|(p, record)| {
+            cwd.join(p)
+                .canonicalize()
+                .ok()
+                .zip(self.root.canonicalize().ok())
+                .is_some_and(|(seen, root)| seen == root)
+                && record
+                    .as_ref()
+                    .is_some_and(|(_, sum)| sum.to_string() == format!("blake3={source}"))
+        })
+    }
+
+    pub(super) fn proves_unused(&self, names: &HashSet<InternedString>) -> bool {
+        self.externs.is_subset(names)
+    }
+
+    /// The transparent unused-extern notification itself is retained in Cargo's diagnostic
+    /// cache. A user-visible warning, extra record, or failed/truncated parse requires rustc.
+    pub(super) fn silent_report(&self, path: &Path) -> bool {
+        #[derive(serde::Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Report {
+            #[serde(rename = "$message_type")]
+            kind: String,
+            lint_level: String,
+            unused_extern_names: HashSet<InternedString>,
+        }
+        let Ok(f) = paths::open_regular(path) else {
+            return false;
+        };
+        if !f.metadata().is_ok_and(|m| m.len() <= 65536) {
+            return false;
+        }
+        serde_json::from_reader::<_, Report>(f.take(65537)).is_ok_and(|r| {
+            r.kind == "unused_extern"
+                && r.lint_level == "allow"
+                && self.proves_unused(&r.unused_extern_names)
+        })
+    }
+
+    pub(super) fn changed_only_unused(&self, fp: &fingerprint::Fingerprint) -> bool {
+        fingerprint::can_skip_cfg_disabled_dependencies(fp, &self.units)
+    }
+}
