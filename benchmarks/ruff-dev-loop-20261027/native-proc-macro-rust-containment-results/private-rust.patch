diff --git a/tests/run-make/incremental-proc-macro-native-inputs/native.rs b/tests/run-make/incremental-proc-macro-native-inputs/native.rs
new file mode 100644
index 0000000000000..b28ecd4ed2171
--- /dev/null
+++ b/tests/run-make/incremental-proc-macro-native-inputs/native.rs
@@ -0,0 +1,18 @@
+#![crate_type = "proc-macro"]
+
+extern crate proc_macro;
+use proc_macro::TokenStream;
+
+unsafe extern "C" {
+    fn value() -> i32;
+}
+
+#[proc_macro_derive(Observe)]
+pub fn observe(_: TokenStream) -> TokenStream {
+    format!("const DERIVED: i32 = {};", unsafe { value() }).parse().unwrap()
+}
+
+#[proc_macro_attribute]
+pub fn observe_attr(_: TokenStream, _: TokenStream) -> TokenStream {
+    format!("const ATTR: i32 = {};", unsafe { value() }).parse().unwrap()
+}
