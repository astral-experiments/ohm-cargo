+    /// Whether this compiler can attest observer inputs during the first compilation.
+    pub fn supports_ohm_observer_dep_info(&self, gctx: &GlobalContext) -> bool {
+        *self.ohm_observer_dep_info.get_or_init(|| {
+            let mut process = self.process();
+            if let Err(error) = apply_env_config(gctx, &mut process) {
+                debug!("unable to configure observer dep-info capability probe: {error}");
+                return false;
+            }
+            process.arg("-Zohm-observer-dep-info").arg("--print=sysroot");
+            self.cached_output(&process, 0).is_ok()
+        })
+    }
