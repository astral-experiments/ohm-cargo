+#[derive(Clone, Debug, Eq, PartialEq, Deserialize, Serialize)]
+pub(super) struct NativeRlibInterface {
+    rust_api: String,
+    linked_statics: String,
+}
+
+/// Contents of every transitive native input from the last full mixed library compilation.
+pub(super) type NativeInputGenerations = std::collections::BTreeMap<PathBuf, String>;
+
+impl Fingerprint {
+    pub(super) fn native_library_producers(&self) -> Vec<(UnitIndex, NativeRlibInterface)> {
+        let mut producers = Vec::new();
+        let mut seen = HashSet::default();
+        let mut remaining: Vec<_> = self.deps.iter().collect();
+        while let Some(dep) = remaining.pop() {
+            if !seen.insert(dep.fingerprint.index) {
+                continue;
+            }
+            if let Some(interface) = dep
+                .fingerprint
+                .native_rlib_interface
+                .lock()
+                .unwrap()
+                .clone()
+            {
+                producers.push((dep.fingerprint.index, interface));
+            }
+            remaining.extend(dep.fingerprint.deps.iter());
+        }
+        producers
+    }
+
+    pub(super) fn native_library_inputs(&self) -> Option<NativeInputGenerations> {
+        let mut inputs = NativeInputGenerations::new();
+        let mut seen = HashSet::default();
+        let mut remaining: Vec<_> = self.deps.iter().collect();
+        while let Some(dep) = remaining.pop() {
+            if seen.insert(dep.fingerprint.index) {
+                for path in &dep.fingerprint.outputs {
+                    inputs.insert(path.clone(), super::cached_file(path.clone()).ok()?.blake3);
+                }
+                remaining.extend(dep.fingerprint.deps.iter());
+            }
+        }
+        Some(inputs)
+    }
+}
+
+/// Verify the complete native input roster from the last full compilation. An input whose
+/// generation changed must have an interface from this invocation, even across an early cutoff.
+pub(super) fn native_library_changes(
+    root: &Fingerprint,
+    previous: &NativeInputGenerations,
+) -> Option<Vec<(UnitIndex, NativeRlibInterface)>> {
+    if !root.is_early_cutoff_candidate() || !root.observed_span_inputs_are_current() {
+        return None;
+    }
+    let mut changed = Vec::new();
+    let mut visited = HashSet::default();
+    let mut found = HashSet::default();
+    let mut remaining: Vec<_> = root.deps.iter().collect();
+    while let Some(dep) = remaining.pop() {
+        let fingerprint = &dep.fingerprint;
+        if !visited.insert(fingerprint.index) {
+            continue;
+        }
+        let rebuilt = match fingerprint.build_state() {
+            BuildState::BuiltUnchanged => {
+                let interface = fingerprint.native_rlib_interface.lock().unwrap().clone()?;
+                changed.push((fingerprint.index, interface));
+                true
+            }
+            BuildState::Fresh | BuildState::SkippedEarlyCutoff => false,
+            _ => return None,
+        };
+        for path in &fingerprint.outputs {
+            let expected = previous.get(path)?;
+            found.insert(path);
+            if !rebuilt && expected != &super::cached_file(path.clone()).ok()?.blake3 {
+                return None;
+            }
+        }
+        remaining.extend(fingerprint.deps.iter());
+    }
+    (!changed.is_empty() && found.len() == previous.len()).then_some(changed)
+}
