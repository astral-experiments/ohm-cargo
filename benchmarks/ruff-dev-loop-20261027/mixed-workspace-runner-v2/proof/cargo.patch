+        && unit_has_exclusive_metadata_access(build_runner, unit)
+        && build_runner.bcx.ws.is_member(&unit.pkg)
+        && unit.kind == CompileKind::Host
+        && build_runner.bcx.host_triple().as_str() == "x86_64-unknown-linux-gnu"
+        && types.len() == 2
+        && types.contains(&CrateType::Cdylib)
+        && types.contains(&CrateType::Rlib)
+        && build_runner.bcx.extra_args_for(unit).is_none()
+        && unit.profile.rustflags.is_empty()
+        && super::unit_rustflags_without_ohm_defaults(
