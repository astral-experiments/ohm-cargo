+const RAW_PATHS: &str = "# ohm-raw-checksum-paths-v2\n";
+const OBSERVER_INPUTS: &str = "# ohm-observer-inputs-v1 ";
+
+fn after_raw_paths(contents: &str) -> &str {
+    contents.strip_prefix(RAW_PATHS).unwrap_or(contents)
+}
+
+/// Decodes the compiler's complete input list only when it describes this same output,
+/// source list and environment. A checksum on a source Rust archive alone is insufficient.
+fn first_observer_dep_info(
+    path: &Path,
+    contents: &str,
+    ordinary: &RustcDepInfo,
+) -> Option<RustcDepInfo> {
+    let after_raw = after_raw_paths(contents);
+    let (header, rules) = after_raw.strip_prefix(OBSERVER_INPUTS)?.split_once('\n')?;
+    let (digest, encoded) = header.split_once(' ')?;
+    let nested = hex::decode(encoded).ok()?;
+    let prefix = &contents[..contents.len() - after_raw.len()];
+    let hash = blake3::Hasher::new()
+        .update(&nested)
+        .update(&[0])
+        .update(prefix.as_bytes())
+        .update(rules.as_bytes())
+        .finalize();
+    let nested = std::str::from_utf8(&nested).ok()?;
+    if digest != format!("blake3={hash}") || !nested.starts_with(RAW_PATHS) {
+        return None;
+    }
+    let target = path.to_str()?;
+    if !rules.strip_prefix(target)?.starts_with(": ")
+        || !after_raw_paths(nested)
+            .strip_prefix(target)?
+            .starts_with(": ")
+    {
+        return None;
+    }
+    let full = parse_rustc_dep_info_contents(path, nested).ok()?;
+    if full.conflicting_checksums
+        || full.env != ordinary.env
+        || !ordinary.files.iter().all(|(p, witness)| {
+            full.files
+                .get(p)
+                .is_some_and(|v| witness.is_none() || witness == v)
+        })
+    {
+        return None;
+    }
+    Some(full)
+}
