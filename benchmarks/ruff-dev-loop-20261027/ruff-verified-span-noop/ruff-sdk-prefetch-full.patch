+/// Split a large fresh observer receipt across the main thread and one spare job slot.
+/// Put its largest input with the smallest ones so both chunks can do useful work.
+#[cfg(unix)]
+fn prefetch_large_observed_inputs(
+    files: &HashMap<PathBuf, Option<(u64, Checksum)>>,
+    cache: &mut HashMap<PathBuf, Checksum>,
+    parallelism: ChecksumParallelism<'_>,
+) {
+    if parallelism.jobs < 2 {
+        return;
+    }
+    let mut misses = files
+        .iter()
+        .filter(|(path, _)| !cache.contains_key(*path))
+        .map(|(path, prior)| (path, *prior))
+        .collect::<Vec<_>>();
+    misses.sort_unstable_by_key(|(_, prior)| prior.map_or(0, |(size, _)| size));
+    let Some(((_, Some((largest, _))), rest)) = misses.split_last() else {
+        return;
+    };
+    if *largest < 32 * 1024 * 1024
+        || rest.iter().fold(0u64, |sum, (_, prior)| {
+            sum.saturating_add(prior.map_or(0, |(size, _)| size))
+        }) < 16 * 1024 * 1024
+    {
+        return;
+    }
+    misses.rotate_right(1);
+    if let Some(results) = prefetch_checksum_batch(&misses, cache, None, parallelism, 2) {
+        for ((path, _), result) in misses.into_iter().zip(results) {
+            if let Some(Ok(checksum)) = result {
+                cache.insert(path.clone(), checksum);
+            }
+        }
+    }
+}
