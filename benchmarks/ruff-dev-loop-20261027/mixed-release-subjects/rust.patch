+/// Links cached local code only when normal incremental metadata would be identical. A failed
+/// check continues the original source compilation with its original build-script environment.
+fn try_relink_mixed(tcx: TyCtxt<'_>, compiler: &interface::Compiler, recipe: &Path) -> Option<()> {
+    let sess = tcx.sess;
+    let current = tcx.output_filenames(());
+    if !sess.opts.unstable_opts.public_api_hash
+        || !sess.opts.unstable_opts.emit_rlink
+        || !tcx.dep_graph.is_fully_enabled()
+        || tcx.crate_types().len() != 2
+        || !tcx.crate_types().contains(&CrateType::Rlib)
+        || !tcx.crate_types().contains(&CrateType::Cdylib)
+        || sess.opts.cg.save_temps
+        || sess.opts.unstable_opts.metrics_dir.is_some()
+        || sess.opts.unstable_opts.dump_mir.is_some()
+        || current.outputs.len() != 3
+        || ![OutputType::DepInfo, OutputType::Metadata, OutputType::Exe]
+            .into_iter()
+            .all(|kind| current.outputs.contains_key(&kind))
+        || current.with_extension(config::RLINK_EXT) != recipe
+    {
+        return None;
+    }
+    let (modules, info, metadata, outputs) =
+        CompiledModules::deserialize_rlink(sess, read_relink_input(recipe)?).ok()?;
+    if !outputs.outputs.iter().eq(current.outputs.iter())
+        || outputs.path(OutputType::Exe) != current.path(OutputType::Exe)
+        || outputs.path(OutputType::Metadata) != current.path(OutputType::Metadata)
+        || metadata.stub_or_full() != metadata.full()
+    {
+        return None;
+    }
+    let OutFileName::Real(path) = rustc_session::output::filename_for_metadata(sess, current)
+    else {
+        return None;
+    };
+    let public_hash = rustc_metadata::fs::checked_relink_public_hash(
+        tcx,
+        metadata.full(),
+        &path,
+        read_relink_input,
+    )?;
+    tcx.dcx().abort_if_errors();
+    let _timer = sess.prof.generic_activity("ohm_checked_mixed_relink");
+    if sess.opts.json_artifact_notifications {
+        sess.dcx().emit_metadata_artifact_notification(&path, Some(&public_hash), None);
+    }
+    compiler.codegen_backend.link(sess, modules, info, metadata, &outputs);
+    Some(())
+}
