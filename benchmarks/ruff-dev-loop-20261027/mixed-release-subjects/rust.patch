+/// Checks the same green work product the normal metadata encoder would copy. An ordinary
+/// downstream crate still requires its exact private hash, including on the first warm rebuild.
+pub fn checked_relink_public_hash(
+    tcx: TyCtxt<'_>,
+    previous: &[u8],
+    published: &Path,
+    read_input: fn(&Path) -> Option<Vec<u8>>,
+) -> Option<String> {
+    let work = tcx.dep_graph.previous_work_product(&WorkProductId::from_cgu_name("metadata"))?;
+    let saved = tcx.incr_comp_session?.session_directory.join(work.saved_files.get("rmeta")?);
+    let bytes = read_input(&saved)?;
+    if bytes.as_slice() != previous || read_input(published)?.as_slice() != previous {
+        return None;
+    }
+    if bytes.len() < METADATA_HEADER.len() + size_of::<u64>() || !bytes.starts_with(METADATA_HEADER)
+    {
+        return None;
+    }
+    let mut metadata = MetadataBlob::new(slice_owned(bytes, Vec::as_slice)).ok()?;
+    metadata.check_compatibility(tcx.sess.cfg_version, || false).ok()?;
+    let hashes = metadata.get_header().hashes;
+    if hashes.private_hash != tcx.crate_hash(LOCAL_CRATE)
+        || tcx.dep_graph.try_mark_green(tcx, &tcx.metadata_dep_node()).is_none()
+    {
+        return None;
+    }
+    Some(hashes.public_hash.to_hex())
+}
