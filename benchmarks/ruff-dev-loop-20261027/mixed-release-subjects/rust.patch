+fn native_rlib_hash(tcx: TyCtxt<'_>) -> Option<String> {
+    if !matches!(&tcx.sess.opts.target_triple, TargetTuple::TargetTuple(name) if name == "x86_64-unknown-linux-gnu")
+        || !tcx.sess.opts.unstable_opts.public_api_hash
+        || tcx.sess.opts.incremental.is_none()
+        || !tcx.dep_graph.is_fully_enabled()
+        || tcx.crate_types() != [CrateType::Rlib]
+        || !tcx.codegen_output_mode(()).0
+        || rustc_hir::find_attr!(
+            tcx,
+            crate,
+            CompilerBuiltins
+                | NoBuiltins
+                | ProfilerRuntime
+                | DefaultLibAllocator
+                | NeedsAllocator
+                | NeedsPanicRuntime
+                | PanicRuntime
+        )
+        || tcx.has_global_allocator(LOCAL_CRATE)
+        || tcx.has_alloc_error_handler(LOCAL_CRATE)
+        || tcx.has_panic_handler(LOCAL_CRATE)
+        || !tcx.externally_implementable_items(LOCAL_CRATE).is_empty()
+        || !tcx.debugger_visualizers(LOCAL_CRATE).is_empty()
+        || !tcx.native_libraries(LOCAL_CRATE).is_empty()
+    {
+        return None;
+    }
+
+    let mut names = StableHasher::new();
+    let mut weak_symbols: Vec<_> = tcx
+        .lang_items()
+        .missing
+        .iter()
+        .filter(|item| item.is_weak())
+        .filter_map(|item| item.link_name())
+        .map(|symbol| symbol.as_str().to_owned())
+        .collect();
+    weak_symbols.sort_unstable();
+    weak_symbols.hash(&mut names);
+    for &(symbol, info) in tcx
+        .exported_non_generic_symbols(LOCAL_CRATE)
+        .iter()
+        .chain(tcx.exported_generic_symbols(LOCAL_CRATE).iter())
+    {
+        if info.level == SymbolExportLevel::C || info.rustc_std_internal_symbol {
+            return None;
+        }
+        if info.used {
+            let ExportedSymbol::NonGeneric(def_id) = symbol else { return None };
+            if info.kind != SymbolExportKind::Data
+                || !def_id.is_local()
+                || !matches!(tcx.def_kind(def_id), DefKind::Static { .. })
+            {
+                return None;
+            }
+            symbol.symbol_name_for_local_instance(tcx).name.hash(&mut names);
+        }
+    }
+    let hash: Fingerprint = names.finish();
+    Some(format!("native-v4:{}", hash.to_hex()))
+}
