+/// Opens a retained compiler input without following a symlink or waiting for a FIFO writer.
+/// The native recipe is currently negotiated only for Linux.
+fn read_relink_input(path: &Path) -> Option<Vec<u8>> {
+    #[cfg(all(target_os = "linux", target_env = "gnu"))]
+    {
+        use std::io::Read;
+        use std::os::unix::fs::OpenOptionsExt;
+        let mut file = fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NONBLOCK | libc::O_NOCTTY | libc::O_NOFOLLOW)
+            .open(path)
+            .ok()?;
+        let info = file.metadata().ok()?;
+        if !info.is_file() {
+            return None;
+        }
+        let mut bytes = Vec::with_capacity(info.len().try_into().ok()?);
+        file.read_to_end(&mut bytes).ok()?;
+        Some(bytes)
+    }
+    #[cfg(not(all(target_os = "linux", target_env = "gnu")))]
+    {
+        let _ = path;
+        None
+    }
+}
