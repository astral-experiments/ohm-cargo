+//@ only-x86_64-unknown-linux-gnu
+//@ ignore-cross-compile
+
+use run_make_support::{cwd, rfs, run, rustc};
+
+fn compile(checked: bool, emit: &str) {
+    let mut cmd = rustc();
+    cmd.input("bundle.rs")
+        .crate_type("cdylib,rlib")
+        .emit(emit)
+        .out_dir(cwd())
+        .incremental("incremental")
+        .arg("-Zpublic-api-hash")
+        .arg("-Zemit-rlink")
+        .arg("-Ztemps-dir=objects");
+    if checked {
+        cmd.arg(format!("-Zohm-checked-mixed-rlink={}", cwd().join("bundle.rlink").display()));
+    }
+    cmd.run();
+}
+
+fn caller(expected: &str) {
+    rustc().input("caller.rs").extern_("bundle", "libbundle.rlib").run();
+    run("caller").assert_stdout_equals(expected);
+}
+
+fn main() {
+    let standard = "dep-info,metadata,link";
+    compile(false, standard);
+    compile(false, standard);
+    let metadata = rfs::read("libbundle.rmeta");
+    let recipe = rfs::read("bundle.rlink");
+    compile(true, standard);
+    // A validated link uses the saved objects and leaves its recipe alone.
+    assert_eq!(recipe, rfs::read("bundle.rlink"));
+    assert_eq!(metadata, rfs::read("libbundle.rmeta"));
+    caller("1");
+
+    // A caller requesting other outputs needs normal compilation even when metadata is green.
+    compile(true, "dep-info,metadata,link,mir=bundle-extra.mir");
+    assert!(rfs::read_to_string("bundle-extra.mir").contains("fn value()"));
+
+    // The saved Rust metadata cannot describe this newly observed local value.
+    rfs::write("bundle.rs", "pub fn value() -> u8 { 2 }\n");
+    compile(true, standard);
+    assert_ne!(metadata, rfs::read("libbundle.rmeta"));
+    caller("2");
+}
