+    fn migrate_escaped_path_checksums() {
+        for name in ["lib/input", "lib/with space"] {
+            let mut info = EncodedDepInfo::default();
+            info.files
+                .push((DepInfoPathType::PackageRootRelative, name.into(), None));
+            let mtime = info.serialize().unwrap();
+            assert_eq!(mtime[5], LEGACY_ENCODED_DEP_INFO_VERSION);
+            assert_eq!(EncodedDepInfo::parse(&mtime).unwrap(), info);
+
+            info.files[0].2 = Some((7, "hash".into()));
+            let mut ordinary = info.serialize().unwrap();
+            assert_eq!(ordinary[5], CURRENT_ENCODED_DEP_INFO_VERSION);
+            assert_eq!(EncodedDepInfo::parse(&ordinary).unwrap(), info);
+            ordinary[5] = LEGACY_ENCODED_DEP_INFO_VERSION;
+            assert!(EncodedDepInfo::parse(&ordinary).is_none());
+
+            info.files.push((
+                DepInfoPathType::BuildRootRelative,
+                "reader.d/ohm-foreign-span-bytes".into(),
+                None,
+            ));
+            info.observer = Some((1, true));
+            let mut observer = info.serialize().unwrap();
+            assert_eq!(EncodedDepInfo::parse(&observer).unwrap(), info);
+            observer[5] = LEGACY_ENCODED_DEP_INFO_VERSION;
+            let end = observer.len() - 32;
+            let digest = blake3::hash(&observer[..end]);
+            observer[end..].copy_from_slice(digest.as_bytes());
+            assert_eq!(
+                EncodedDepInfo::parse(&observer).unwrap().observer,
+                Some((1, name == "lib/input"))
+            );
+        }
+    }
