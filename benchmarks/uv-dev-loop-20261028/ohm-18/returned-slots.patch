+    /// Runs a later linking phase on jobserver slots returned since the original pool started.
+    pub(crate) fn with_returned_jobserver_slots<T: Send>(
+        &self,
+        work: impl FnOnce() -> T + Send,
+    ) -> T {
+        let Some(client) = self
+            .jobserver_client
+            .as_ref()
+            .filter(|_| self.retry_jobserver)
+        else {
+            return work();
+        };
+        let mut slots = Vec::new();
+        while slots.len() < DEFAULT_THREAD_CAP.get() - 1 {
+            let Ok(Some(slot)) = client.try_acquire() else {
+                break;
+            };
+            slots.push(slot);
+        }
+        // The original worker keeps its implicit slot. A separate pool needs two additional
+        // slots before it can run the remaining work faster than that worker alone.
+        if slots.len() < 2 {
+            drop(slots);
+            return work();
+        }
+
+        let count = slots.len();
+        tracing::trace!(count, "Acquired late jobserver tokens");
+        let mut work = Some(work);
+        let result = ThreadPoolBuilder::new().num_threads(count).build_scoped(
+            |worker| worker.run(),
+            |pool| pool.install(work.take().unwrap()),
+        );
+        // Join this pool, including any background Rayon work, before returning its physical
+        // tokens. The CLI may exit immediately after linking.
+        drop(slots);
+        match result {
+            Ok(value) => value,
+            Err(_) => work.unwrap()(),
+        }
+    }
+
