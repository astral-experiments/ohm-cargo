+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+#[cargo_test]
+fn ohm_small_incremental_bins_use_one_frontend_thread() {
+    let wrapper = ohm_defaults_wrapper();
+    let manifest = format!(
+        "{}\n[profile.custom]\ninherits = \"dev\"\n",
+        basic_manifest("foo", "0.1.0")
+    );
+    let main = "fn main() {}";
+    let p = project()
+        .file("Cargo.toml", &manifest)
+        .file("src/main.rs", main)
+        .file("src/bin/other.rs", main)
+        .file(
+            "build.rs",
+            r#"fn main() {
+                let out = std::path::PathBuf::from(std::env::var_os("OUT_DIR").unwrap());
+                std::fs::write(out.join("message"), "generated").unwrap();
+            }"#,
+        )
+        .build();
+    let log = p.root().join("ohm-defaults.log");
+    let bin = &["--crate-type", "bin"][..];
+    let harness = &["--test"][..];
+    let custom_harness = &["--cfg", "test"][..];
+    let check = |name: &str, role: &[&str], expected: &[&str]| {
+        let log = fs::read_to_string(&log).unwrap();
+        let invocations: Vec<_> = rustc_invocations(&log, name).collect();
+        let [args] = invocations.as_slice() else {
+            panic!("expected one rustc invocation for {name}, got {invocations:?}");
+        };
+        let roles: Vec<_> = [bin, harness, custom_harness]
+            .into_iter()
+            .filter(|flags| args.windows(flags.len()).any(|pair| pair == *flags))
+            .collect();
+        assert_eq!(roles, [role], "{name}: {args:?}");
+        assert_eq!(frontend_threads(args), expected, "{name}: {args:?}");
+    };
+    let mut edit = 0;
+    let mut run = |command: &str, source: &str, role: &[&str], expected: &[&str]| {
+        edit += 1;
+        p.change_file("src/main.rs", &format!("// Edit {edit}\n{source}"));
+        fs::write(&log, "").unwrap();
+        p.cargo(&format!("-Zohm-defaults {command}"))
+            .masquerade_as_nightly_cargo(&["ohm-defaults"])
+            .env("CARGO_INCREMENTAL", "1")
+            .env("RUSTC_WRAPPER", &wrapper)
+            .env("OHM_DEFAULTS_LOG", &log)
+            .run();
+        check("foo", role, expected);
+    };
+
+    run("build", main, bin, &["8"]);
+    let dep_info = |name: &str| {
+        WalkDir::new(p.build_dir())
+            .into_iter()
+            .map(|entry| entry.unwrap())
+            .find(|entry| entry.file_name() == name)
+            .expect("previous bin dep-info")
+            .into_path()
+    };
+    let foo_hint = dep_info("dep-bin-foo");
+    fs::write(&foo_hint, b"invalid dep-info").unwrap();
+    p.change_file("src/bin/other.rs", "fn main() { println!(\"first\"); }");
+    run("build", main, bin, &["8"]);
+    check("other", bin, &["8", "1"]);
+
+    // Force foo to compile with the other bin's genuine single-source hint.
+    fs::copy(dep_info("dep-bin-other"), &foo_hint).unwrap();
+    fs::remove_file(foo_hint.with_file_name("bin-foo")).unwrap();
+    run("build --bin foo", main, bin, &["8"]);
+    run("build", main, bin, &["8", "1"]);
+    run("test --bin foo --no-run", main, harness, &["8"]);
+    run("test --bin foo --no-run", main, harness, &["8", "1"]);
+
+    let generated =
+        r#"fn main() { print!("{}", include_str!(concat!(env!("OUT_DIR"), "/message"))); }"#;
+    run("build", generated, bin, &["8", "1"]);
+    run("build", generated, bin, &["8"]);
+    p.process(p.bin("foo")).with_stdout_data("generated").run();
+
+    for command in [
+        "build --profile custom",
+        "build --config profile.dev.opt-level=1",
+    ] {
+        run(command, main, bin, &["8"]);
+        run(command, main, bin, &["8"]);
+    }
+    p.change_file(
+        "Cargo.toml",
+        &format!("{manifest}\n[[bin]]\nname = \"foo\"\npath = \"src/main.rs\"\nharness = false\n"),
+    );
+    run("test --bin foo --no-run", main, custom_harness, &["8"]);
+    run("test --bin foo --no-run", main, custom_harness, &["8"]);
+}
