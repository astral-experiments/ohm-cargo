+/// Uses the previous dep-info to identify incremental work where coordinating
+/// frontend threads can cost more than compiling the crate.
+fn unit_has_small_frontend_input(build_runner: &BuildRunner<'_, '_>, unit: &Unit) -> bool {
+    let small_file = |path: &Path| {
+        path.metadata()
+            .is_ok_and(|info| info.is_file() && info.len() <= 16 * 1024)
+    };
+    match unit.mode {
+        CompileMode::Check { test: false } => {
+            return small_file(&fingerprint::dep_info_loc(build_runner, unit));
+        }
+        CompileMode::Build => {}
+        CompileMode::Test if unit.target.harness() => {}
+        _ => return false,
+    }
+    if !unit.target.is_bin()
+        || unit.artifact.is_true()
+        || !matches!(unit.profile.name.as_str(), "dev" | "test")
+        || unit.profile.opt_level.as_str() != "0"
+    {
+        return false;
+    }
+    let Some(source) = unit.target.src_path().path() else {
+        return false;
+    };
+    let dep_info = fingerprint::dep_info_loc(build_runner, unit);
+    if !small_file(&dep_info) {
+        return false;
+    }
+    let build_root = build_runner.files().build_root(unit);
+    let Some(mut paths) = fingerprint::dep_info_paths(unit.pkg.root(), &build_root, &dep_info)
+    else {
+        return false;
+    };
+    // A small bin entry point can pull in large modules or generated inputs.
+    paths.next().as_deref() == Some(source) && paths.next().is_none() && small_file(source)
+}
